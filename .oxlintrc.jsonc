{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  // Enable TypeScript, Unicorn, Oxc, Node, JSDoc, and Import plugins
  "plugins": ["typescript", "unicorn", "oxc", "node", "jsdoc", "import"],
  // Environment settings
  "env": {
    "builtin": true,
    "es2024": true,
    "browser": true,
    "node": true,
  },
  // Ignore patterns
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".honox",
    ".direnv",
    "*.log",
    "/nix/store/**",
    // Generated files
    "app/lib/posts-data.ts",
    "app/lib/posts-data.d.ts",
    // Design handoff artifacts, not product code
    "design_handoff_paper_blog",
    "design_handoff_looseleaf",
  ],
  // Rule categories - maximum strictness: ALL categories enabled as error
  // - correctness (196 rules): Catch definite bugs and errors
  // - suspicious (47 rules): Flag potentially problematic patterns
  // - pedantic (106 rules): Stricter code quality checks (includes no-throw-literal, require-await, ban-ts-comment, etc.)
  // - perf (11 rules): Performance-related issues
  // - style (168 rules): Code style rules
  // - restriction (68 rules): Ban entire language constructs; incompatible rules are opted out below with rationale
  // - nursery (8 rules): Experimental rules, still enabled for maximum strictness
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "error",
  },
  "rules": {
    // ===================
    // Restriction rules opted out (each bans a construct this project relies on)
    // ===================
    // async/await is the async model of this SSG codebase; the rule targets generator-based codebases
    "oxc/no-async-await": "off",
    // Optional chaining (ES2020) is supported by all build/runtime targets (env is es2024)
    "oxc/no-optional-chaining": "off",
    // Object rest/spread (ES2018) is supported by all targets
    "oxc/no-rest-spread-properties": "off",
    // `undefined` is the idiomatic absence value in TypeScript (optional props, `?? undefined`);
    // the rule guards against pre-ES5 environments where `undefined` was mutable
    "no-undefined": "off",
    // Direct opposite of no-default-export (both live in restriction); named exports win
    "import/prefer-default-export": "off",
    // Always `return await` for better stack traces; also satisfies require-await
    // in async delegation functions required by promise-function-async
    "typescript/return-await": ["error", "always"],
    // ===================
    // Override category defaults with custom options
    // ===================
    // Unused variables - allow underscore prefix for intentional unused
    "no-unused-vars": [
      "error",
      {
        "vars": "all",
        "varsIgnorePattern": "^_",
        "args": "after-used",
        "argsIgnorePattern": "^_",
      },
    ],
    // Limit cyclomatic complexity (not in any category)
    "complexity": [
      "error",
      {
        "max": 7,
      },
    ],
    // ===================
    // TypeScript Rules
    // ===================
    // Unused variables (TypeScript version) - allow underscore prefix
    "typescript/no-unused-vars": [
      "error",
      {
        "vars": "all",
        "varsIgnorePattern": "^_",
        "args": "after-used",
        "argsIgnorePattern": "^_",
      },
    ],
    // Disallow explicit `any` usage (restriction category)
    "typescript/no-explicit-any": "error",
    // Disallow floating promises - must handle or void
    "typescript/no-floating-promises": "error",
    // Error on awaiting non-thenable values
    "typescript/await-thenable": "error",
    // Enforce `import type` with separate style
    // (inline style conflicts with restriction rule no-import-type-side-effects)
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "disallowTypeAnnotations": false,
        "fixStyle": "separate-type-imports",
      },
    ],
    // Disallow unnecessary type arguments
    "typescript/no-unnecessary-type-arguments": "error",
    // Enforce strict boolean expressions - no implicit coercion
    // Requires --type-aware flag
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowNullableBoolean": false,
        "allowNullableObject": false,
        "allowString": false,
        "allowNumber": false,
      },
    ],
    // Disallow classes with only static members
    "typescript/no-extraneous-class": "error",
    // Ban @ts-ignore, allow @ts-expect-error with description (override pedantic default)
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": true,
        "ts-expect-error": "allow-with-description",
      },
    ],
    // ===================
    // Node.js Rules
    // ===================
    // Disallow direct assignment to exports
    "node/no-exports-assign": "error",
    // Disallow new require calls
    "node/no-new-require": "error",
    // ===================
    // JSDoc Rules
    // ===================
    "jsdoc/check-access": "warn",
    "jsdoc/check-property-names": "warn",
    "jsdoc/empty-tags": "warn",
    "jsdoc/implements-on-classes": "warn",
    "jsdoc/no-defaults": "warn",
    "jsdoc/require-param-name": "warn",
    "jsdoc/require-property": "warn",
    "jsdoc/require-property-description": "warn",
    "jsdoc/require-property-name": "warn",
    "jsdoc/require-returns-description": "warn",
    // ===================
    // Import Rules
    // ===================
    // Allow up to 15 dependencies for route files with many component imports
    "import/max-dependencies": ["error", { "max": 15 }],
    // Enforce top-level `import type` style (compatible with no-import-type-side-effects)
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    // Separate `import type` lines are required by consistent-type-specifier-style,
    // so they must not count as duplicates
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    // Ensure imports are at the top
    "import/first": "error",
    // Disallow duplicate imports
    "import/no-duplicates": "error",
    // Disallow mutable exports
    "import/no-mutable-exports": "error",
    // Disallow named default exports
    "import/no-named-default": "error",
    // Allow named exports (common pattern for multi-function modules)
    "import/no-named-export": "off",
    // ===================
    // Unicorn Rules
    // ===================
    // Disable top-level await in src (library code should not use top-level await)
    "unicorn/prefer-top-level-await": "off",
    // ===================
    // Style Rules
    // ===================
    // Enforce consistent brace style for all control statements
    "curly": ["error", "all"],
    // Allow common magic numbers
    "no-magic-numbers": [
      "error",
      {
        "ignore": [-1, 0, 1],
      },
    ],
    // Sort imports - ignore declaration sort to avoid conflicts with syntax ordering
    "sort-imports": [
      "error",
      {
        "ignoreDeclarationSort": true,
      },
    ],
    // Allow PascalCase library functions that aren't constructors
    "new-cap": [
      "error",
      {
        "capIsNewExceptions": ["MarkdownIt", "Shiki"],
      },
    ],
    // Allow common short identifiers
    "id-length": [
      "error",
      {
        "exceptions": ["c", "md"],
      },
    ],
  },
  "overrides": [
    {
      // HonoX file-based routing requires default exports in routes and the server entry.
      // Tool config files (vite, knip) are loaded the same way by their loaders
      "files": ["app/routes/**", "app/server.ts", "vite.config.ts", "knip.config.ts"],
      "rules": {
        "import/no-default-export": "off",
      },
    },
    {
      // Config object keys follow each tool's documented order (build, plugins, entry, project).
      // Alphabetising them makes the file harder to check against the upstream docs
      "files": ["vite.config.ts", "knip.config.ts"],
      "rules": {
        "sort-keys": "off",
      },
    },
    {
      // Ambient declaration files have no imports/exports by nature
      "files": ["**/*.d.ts"],
      "rules": {
        "import/unambiguous": "off",
      },
    },
    {
      // hono/jsx element type includes Promise<HtmlEscapedString>, so these rules
      // would force every JSX component to be async and change render semantics
      "files": ["**/*.tsx"],
      "rules": {
        "typescript/promise-function-async": "off",
        "typescript/return-await": "off",
      },
    },
    {
      // HonoX server entry point has type inference issues with createApp
      "files": ["app/server.ts"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
      },
    },
    {
      // Relaxed rules for test files
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "test/**/*.ts"],
      "rules": {
        "no-console": "off",
        "no-magic-numbers": "off",
        "typescript/no-explicit-any": "warn",
        "typescript/no-floating-promises": "warn",
        "max-lines-per-function": "off",
        "no-await-in-loop": "off",
        // A test body is a straight arrange/act/assert sequence; splitting it to
        // satisfy a statement count hides what is being verified
        "max-statements": "off",
      },
    },
    {
      // Build scripts can use console
      "files": ["scripts/**/*.ts"],
      "rules": {
        "no-console": "off",
        "unicorn/prefer-top-level-await": "error",
        // A CLI reports failure through its exit status; there is no caller to throw to
        "unicorn/no-process-exit": "off",
        // $EDITOR is the interface for "which editor to open", set by the user's shell
        "node/no-process-env": "off",
      },
    },
    {
      // JSX components tend to be longer due to markup
      "files": ["**/*.tsx"],
      "rules": {
        "max-lines-per-function": ["error", { "max": 100 }],
      },
    },
  ],
}
