{
  "name": "raizawa-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build && pagefind --site dist",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint --type-check -c .oxlintrc.jsonc --type-aware .",
    "lint:fix": "oxlint --type-check -c .oxlintrc.jsonc --type-aware . --fix",
    "typecheck": "tsgo --noEmit",
    "knip": "knip",
    "format": "nix fmt",
    "format:check": "nix fmt -- --fail-on-change",
    "new-post": "bun run scripts/new-post.ts",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run test"
  },
  "dependencies": {
    "@shikijs/transformers": "^3.21.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/markdown-it": "^14.1.2",
    "daisyui": "^5.5.18",
    "gray-matter-es": "^0.2.1",
    "hono": "^4.11.3",
    "honox": "^0.1.53",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "shiki": "^3.21.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@hono/vite-ssg": "^0.3.2",
    "knip": "^6.31.0",
    "pagefind": "^1.5.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  }
}
